# ORION Sentinel AI — environment configuration
#
# The application runs configuration-free out of the box: there are NO required
# environment variables, and every value below is OPTIONAL. Copy this file to
# `.env` only if you need to override a default (see docs/development.md).
# Vite exposes variables prefixed with `VITE_` to the client at build time;
# anything else is only visible to the server tooling.

# Satellite imagery tile templates, comma-separated (templates are rotated
# round-robin for load balancing). Supports {z}, {y}, {x} placeholders.
# Defaults to the public Esri World Imagery service (src/globe/imagery.js).
# VITE_IMAGERY_TILE_URLS=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x},https://tiles.example.com/imagery/{z}/{x}/{y}

# Maximum number of tiles kept in the in-memory LRU cache (default: 640).
# VITE_IMAGERY_CACHE_LIMIT=640
