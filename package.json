{
  "name": "orion-sentinel-ai",
  "version": "1.0.0",
  "description": "A cinematic planetary intelligence platform — a real-time 3D Earth observation and anomaly-detection command center powered by simulated AI agents.",
  "type": "module",
  "main": "electron/main.js",
  "private": true,
  "license": "MIT",
  "author": "ORION Sentinel AI Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nortaq-PlayNexus/orion-sentinel-ai"
  },
  "homepage": "https://github.com/Nortaq-PlayNexus/orion-sentinel-ai#readme",
  "bugs": {
    "url": "https://github.com/Nortaq-PlayNexus/orion-sentinel-ai/issues"
  },
  "keywords": [
    "earth-observation",
    "satellite-imagery",
    "gis",
    "threejs",
    "react",
    "webgl",
    "anomaly-detection",
    "data-visualization",
    "command-center",
    "oceanography",
    "uap-analysis"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm run test && npm run build",
    "typecheck": "echo \"This project uses JavaScript (JSX). Type checking is provided by oxlint.\" && exit 0",
    "electron:build": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "prettier": "^3.4.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "ai.orion.sentinel",
    "productName": "ORION Sentinel AI",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "electron@44.0.0": true,
    "electron-winstaller@5.4.0": true
  }
}
